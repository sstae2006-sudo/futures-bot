# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Runtime state (see docs/ARCHITECTURE.md -- these must never be committed;
# state.py/journal.py write to them, and they're specific to one machine's run)
logs/
state/
decisions.jsonl

# scripts/start.ps1's PID files and redirected backend/frontend logs --
# machine-specific runtime state, not source. See BOOT_CHECKLIST.md.
.startup/

# Phase 6A: research API artifacts
research.db
research.db-shm
research.db-wal
api_reports/

# Local market-data caches and generated backtest reports -- large,
# machine-specific, and regenerable via tools/ and the fetch/convert scripts.
market_data*.db
market_data*.db-shm
market_data*.db-wal
data/
turtle_raw/
turtle_converted/
reports/

# Root-level scratch CSVs from manual CLI testing / data-pipeline debugging.
test.csv
test2.csv
test3.csv
test_mnq.csv
test_old.csv
test_mes.csv
live_test.csv
part_*.csv
data_MES*.csv
data_MESH6*.csv

# Local-only scratch scripts -- not reusable tooling, kept on this machine only.
find_mes.py
json_to_csv.py
compare_strategies.ps1

# Phase 9: trained ML model artifacts (joblib/torch files)
ml_models/

# Phase 10.1: uploaded client trade-import files awaiting confirmation
import_staging/

# Phase 10.2: config.yaml backups taken before every param deploy/rollback
config_backups/

# Team deployment: tools/backup_timescaledb.py's pg_dump output + marker
db_backups/

# Team deployment: pre-migration backup snapshots taken by hand (see
# PROJECT_STATE.md's migration instructions) -- large, regenerable, machine-specific.
# Two naming patterns have been used across sessions (research_backup.db and
# research.db.backup_<timestamp>) -- both covered so neither slips through.
research_backup*.db
research_backup*.db-shm
research_backup*.db-wal
market_data_backup*.db
market_data_backup*.db-shm
market_data_backup*.db-wal
research.db.backup_*
market_data.db.backup_*

# Stray Vite dependency cache when `vite`/`npx vite` runs from the repo root
# instead of frontend/ (frontend/.vite/ is already covered below).
/.vite/

# Frontend (Phase 6A)
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Secrets -- config.yaml itself is tracked (it holds no credentials by
# design; see brokers/tradovate.py's module docstring), but a local .env
# some shells may source for TRADOVATE_*/MASSIVE_API_KEY should never be.
.env
